{
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NoelDeMartin/aerogel.git",
        "directory": "playground"
    },
    "type": "module",
    "scripts": {
        "build": "vp build",
        "dev": "vp dev",
        "dev:serve-pod": "community-solid-server -c @css:config/file.json -f ./solid",
        "e2e:dev": "concurrently --kill-others \"vp run e2e:serve-app\" \"vp run e2e:serve-pod\" \"vp run e2e:open\"",
        "e2e:open": "UI=true playwright test --ui",
        "e2e:run": "playwright test",
        "e2e:serve-app": "vp dev --port 5001 --mode testing",
        "e2e:serve-pod": "community-solid-server -l warn",
        "e2e:test:chromium": "start-server-and-test e2e:serve-app http-get://localhost:5001 e2e:serve-pod http-get://localhost:3000 'vp run e2e:run --project=chromium'",
        "e2e:test:firefox": "start-server-and-test e2e:serve-app http-get://localhost:5001 e2e:serve-pod http-get://localhost:3000 'vp run e2e:run --project=firefox'",
        "e2e:test:webkit": "start-server-and-test e2e:serve-app http-get://localhost:5001 e2e:serve-pod http-get://localhost:3000 'vp run e2e:run --project=webkit'",
        "type-check": "vue-tsc --build --force"
    },
    "dependencies": {
        "@aerogel/core": "workspace:*",
        "@aerogel/plugin-i18n": "workspace:*",
        "@aerogel/plugin-local-first": "workspace:*",
        "@aerogel/plugin-routing": "workspace:*",
        "@aerogel/plugin-solid": "workspace:*",
        "@noeldemartin/solid-utils": "catalog:",
        "@noeldemartin/utils": "catalog:",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.16",
        "soukai-bis": "catalog:",
        "tailwindcss": "^4.1.4",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@aerogel/cli": "workspace:*",
        "@aerogel/playwright": "workspace:*",
        "@aerogel/vite": "workspace:*",
        "@intlify/unplugin-vue-i18n": "catalog:",
        "@noeldemartin/scripts": "catalog:",
        "@playwright/test": "^1.60.0",
        "@solid/community-server": "^7.1.3",
        "@types/node": "catalog:",
        "autoprefixer": "^10.4.14",
        "concurrently": "^8.0.1",
        "publint": "catalog:",
        "start-server-and-test": "^2.0.0",
        "unplugin-icons": "catalog:",
        "unplugin-vue-components": "catalog:"
    }
}
