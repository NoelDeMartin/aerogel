{
    "name": "@aerogel/plugin-solid",
    "version": "0.1.2",
    "license": "MIT",
    "author": "Noel De Martin",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NoelDeMartin/aerogel.git",
        "directory": "packages/plugin-solid"
    },
    "files": [
        "src",
        "dist",
        "!src/**/*.test.ts",
        "!src/**/*.stories.tsx"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "style": "./src/index.css",
            "default": "./dist/index.js"
        },
        "./models-worker": {
            "types": "./dist/models-worker.d.ts",
            "default": "./dist/models-worker.js"
        },
        "./setup-vitest": {
            "types": "./dist/setup-vitest.d.ts",
            "default": "./dist/setup-vitest.js"
        }
    },
    "scripts": {
        "build": "vp build",
        "test": "vp test",
        "type-check": "vue-tsc --noEmit",
        "verify": "noeldemartin-verify"
    },
    "dependencies": {
        "@inrupt/solid-client-authn-browser": "^3.1.1",
        "@noeldemartin/solid-utils": "catalog:",
        "@noeldemartin/utils": "catalog:",
        "solid-auth-client": "2.4.1",
        "soukai-bis": "catalog:"
    },
    "devDependencies": {
        "@aerogel/core": "workspace:*",
        "@aerogel/plugin-local-first": "workspace:*",
        "@aerogel/vite": "workspace:*",
        "@arethetypeswrong/cli": "catalog:",
        "@noeldemartin/scripts": "catalog:",
        "fake-indexeddb": "catalog:",
        "publint": "catalog:",
        "zod": "catalog:"
    },
    "peerDependencies": {
        "@aerogel/core": "*",
        "@aerogel/vite": "*",
        "soukai-bis": "*",
        "vite-plus": "catalog:",
        "zod": "catalog:"
    }
}
