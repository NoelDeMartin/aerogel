        "vite": "catalog:",
        "vite-plus": "catalog:"
    },
    "peerDependencies": {
        "@aerogel/core": "*",
        "@aerogel/plugin-solid": "*",
        "@noeldemartin/solid-utils": "catalog:",
        "@storybook/vue3-vite": "^10.0.0",
